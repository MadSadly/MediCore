server {
    listen 80;

    # ── WJ: 뇌종양 (내 PC, 로컬) ──────────────────────────────────
    location /ai/brain/ {
        proxy_pass http://${WORKER_BRAIN_IP}:8000/ai/brain/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
    }

    # ── DH: 허리디스크 ─────────────────────────────────────────────
    location /ai/spine/ {
        proxy_pass http://${WORKER_SPINE_IP}:8000/ai/spine/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
    }

    # ── GW: 대장암 ─────────────────────────────────────────────────
    location /ai/colon/ {
        proxy_pass http://${WORKER_COLON_IP}:8000/ai/colon/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
    }

    # ── MS: 피부질환 ───────────────────────────────────────────────
    location /ai/skin/ {
        proxy_pass http://${WORKER_SKIN_IP}:8000/ai/skin/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
    }

    # ── NJ: 신부전 ─────────────────────────────────────────────────
    location /ai/kidney/ {
        proxy_pass http://${WORKER_KIDNEY_IP}:8000/ai/kidney/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
    }

    # ── SH: 안과질환 ───────────────────────────────────────────────
    location /ai/eyes/ {
        proxy_pass http://${WORKER_EYES_IP}:8000/ai/eyes/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
    }

    # ── Spring API ─────────────────────────────────────────────────
    location /api/ {
        proxy_pass http://192.168.0.39:8080/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
    }

    # ── React 프론트 ───────────────────────────────────────────────
    location / {
        proxy_pass http://192.168.0.39:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
    }
}
