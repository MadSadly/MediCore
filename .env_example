# =====================================================================
# MEDI-Zero 환경변수 템플릿
# 이 파일을 복사해서 .env 로 만들고 실제 값을 채우세요.
# .env 는 절대 git에 커밋하지 마세요!
# cp .env_example .env
# =====================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────
DB_PASSWORD=your_strong_password_here

# ── Redis ────────────────────────────────────────────────────────────
REDIS_PASSWORD=your_redis_password_here

# ── CORS (운영 도메인 또는 로컬 주소) ────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── CloudType / Cloudflare Tunnel 사용 시 추가 ───────────────────────
# CORS_ALLOWED_ORIGINS=https://your-cloudtype-domain.cloudtype.app
