# =====================================================================
# MEDI-Zero 환경변수 템플릿
# 이 파일을 복사해서 .env 로 만들고 실제 값을 채우세요.
# .env 는 절대 git에 커밋하지 마세요!
# cp .env_example .env
# =====================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────
DB_PASSWORD=your_strong_password_here

# ── Redis ────────────────────────────────────────────────────────────
REDIS_PASSWORD=your_redis_password_here

# ── CORS ─────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Google Vertex AI (Gemini LLM) ────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=asia-northeast3          # 서울 리전 (변경 불필요)
GEMINI_MODEL=gemini-1.5-flash-001     # flash: 빠름/저렴, pro: 정확
GCP_KEY_PATH=./secrets/gcp-key.json  # 서비스 계정 키 파일 경로

# ── 워커 PC 고정 IP (Master PC .env에만 필요) ────────────────────────
WORKER1_IP=192.168.0.20    # 피부
WORKER2_IP=192.168.0.9     # 뇌종양
WORKER3_IP=192.168.0.32    # 안과
WORKER4_IP=192.168.0.13    # 척추
WORKER5_IP=192.168.0.5     # 신장
WORKER6_IP=192.168.0.73    # 대장암

# ── 워커 PC .env에만 필요 ────────────────────────────────────────────
MODULE_NAME=skin             # 본인 담당 질환으로 변경
MASTER_IP=192.168.0.39     # Master PC IP